# Backend — copy to .env next to server.js

NODE_ENV=development
PORT=3001

# Must match the browser origin where the SPA is served (credentialed CORS)
ALLOWED_ORIGIN=http://localhost:5173

# Required for JWT signing — use a long random string, not this placeholder
JWT_SECRET=

# Required for db:init when no admin user exists yet (no default in code)
ADMIN_INIT_PASSWORD=

# SQLite path (relative to cwd when you start the server)
DB_PATH=./data.db

# Optional
# JWT_EXPIRES_IN=15m
# REFRESH_EXPIRES_IN=7d
# GLOBAL_RATE_PER_MIN=300
# LOGIN_RATE_MAX=5
# LOGIN_RATE_WINDOW_MS=900000
# UPLOAD_MAX_BYTES=5242880
# LOG_REQUESTS=false
